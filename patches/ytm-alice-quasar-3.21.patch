+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestIsRefusal(t *testing.T) {
+	yes := []string{
+		"Воспроизведение видео не поддерживается на этом устройстве.",
+		"Для этого нужна подписка Плюс.",
+		"Этот контент недоступен в вашей стране.",
+	}
+	no := []string{"Включаю", "Daft Punk. Around the World", "", "Сейчас играет"}
+	for _, s := range yes {
+		if !isRefusal(s) {
+			t.Errorf("expected refusal: %q", s)
+		}
+	}
+	for _, s := range no {
+		if isRefusal(s) {
+			t.Errorf("unexpected refusal: %q", s)
+		}
+	}
+}
+
+// Frames as seen on quasar 3.21 (jbl_link_portable).
+func TestDecodeAliceLegacyFrames(t *testing.T) {
+	// speech_kit_event { on_phrase_spotted { phrase: "алиса" } }
+	spot := pb(43, pb(1, pb(1, []byte("алиса"))))
+	if e := decodeAlice(spot); !e.Spotted || e.HasState {
+		t.Fatalf("spotter frame: %+v", e)
+	}
+	// alice_state { state: 3, vins_response { text: "..." } }
+	text := "Воспроизведение видео не поддерживается на этом устройстве."
+	busy := pb(3, append(pi(1, 3), pb(3, pb(1, []byte(text)))...))
+	e := decodeAlice(busy)
+	if !e.HasState || e.State != 3 || e.Speech != text || e.Spotted {
+		t.Fatalf("busy frame: %+v", e)
+	}
+}
+
+func TestAnnounceGate(t *testing.T) {
+	announceGateOpen()
+	start := time.Now()
+	announceGateWait(time.Second) // open gate: no wait
+	if time.Since(start) > 100*time.Millisecond {
+		t.Fatal("open gate blocked")
+	}
+	announceGateClose()
+	go func() { time.Sleep(50 * time.Millisecond); announceGateOpen() }()
+	start = time.Now()
+	announceGateWait(2 * time.Second)
+	if d := time.Since(start); d < 40*time.Millisecond || d > time.Second {
+		t.Fatalf("gate wait %v", d)
+	}
+	announceGateClose()
+	start = time.Now()
+	announceGateWait(80 * time.Millisecond) // never opened: times out
+	if d := time.Since(start); d < 70*time.Millisecond {
+		t.Fatalf("gate timeout %v", d)
+	}
+	announceGateOpen()
+}
+
+func TestLikedVoiceCommand(t *testing.T) {
+	v := defaultSettings()
+	v.VoiceCommands = map[string]string{"включи музыку": "liked"}
+	s := &Server{settings: &v}
+	a, q, ok := s.voiceAction("Алиса, включи музыку")
+	if !ok || a != "play" || q != "мои лайки" {
+		t.Fatalf("voiceAction = %q %q %v", a, q, ok)
+	}
+	if err := validateSettings(v); err != nil {
+		t.Fatalf("liked must be an allowed action: %v", err)
+	}
+}
