+// Alice speaks through the "default" PCM, whose softvol control is
+// ShadowMaster; ytm-play goes through ytmout, whose control is Master. While a
+// voice command is being taken, ShadowMaster is muted for a moment so the
+// cloud's refusal is never heard, not even its first syllable, while the music
+// keeps playing. The previous value is kept in a file so that a crash during
+// that moment cannot leave Alice mute: serve() restores it on start.
+const shadowSaved = "/tmp/ytm-shadow-saved"
+
+var (
+	shadowMu     sync.Mutex
+	shadowGen    uint64
+	shadowTimer  *time.Timer
+	muteDeadline atomic.Int64 // unix nanos: never stay muted past this
+	// Alice is vocalizing a refusal right now (state 2). A dropped reply can
+	// keep playing into the muted channel for a few hundred milliseconds.
+	aliceRefusalSpeaking atomic.Bool
+)
+
+func shadowGet() string {
+	out, err := exec.Command("amixer", "-c0", "cget", "name=ShadowMaster").Output()
+	if err != nil {
+		return ""
+	}
+	for _, l := range strings.Split(string(out), "\n") {
+		if i := strings.Index(l, ": values="); i >= 0 {
+			return strings.TrimSpace(l[i+len(": values="):])
+		}
+	}
+	return ""
+}
+
+func shadowSet(v string) {
+	exec.Command("amixer", "-q", "-c0", "cset", "name=ShadowMaster", v).Run()
+}
+
+// muteAlice silences Alice's voice and schedules its restoration.
+func muteAlice(restoreAfter time.Duration) {
+	shadowMu.Lock()
+	defer shadowMu.Unlock()
+	if _, err := os.Stat(shadowSaved); err != nil {
+		v := shadowGet()
+		if v == "" {
+			return
+		}
+		if os.WriteFile(shadowSaved, []byte(v), 0600) != nil {
+			return
+		}
+		shadowSet("0,0")
+		muteDeadline.Store(time.Now().Add(4 * time.Second).UnixNano())
+		voiceLog("ShadowMaster %s -> 0 (Alice muted)", v)
+	}
+	shadowGen++
+	gen := shadowGen
+	if shadowTimer != nil {
+		shadowTimer.Stop()
+	}
+	shadowTimer = time.AfterFunc(restoreAfter, func() { restoreAlice(gen) })
+}
+
+// rescheduleAliceRestore moves the pending restoration, keeping Alice muted a
+// little longer after a refusal was dropped.
+func rescheduleAliceRestore(after time.Duration) {
+	shadowMu.Lock()
+	defer shadowMu.Unlock()
+	if _, err := os.Stat(shadowSaved); err != nil {
+		return
+	}
+	shadowGen++
+	gen := shadowGen
+	if shadowTimer != nil {
+		shadowTimer.Stop()
+	}
+	shadowTimer = time.AfterFunc(after, func() { restoreAlice(gen) })
+}
+
+// restoreAlice puts Alice's voice back (gen 0 forces it) and lets a pending
+// announcement through.
+func restoreAlice(gen uint64) {
+	// Do not unmute while she is still saying the refusal: wait for her to
+	// leave state 2, within the hard deadline.
+	if gen != 0 && aliceRefusalSpeaking.Load() && time.Now().UnixNano() < muteDeadline.Load() {
+		voiceLog("refusal still being spoken: keep Alice muted")
+		rescheduleAliceRestore(150 * time.Millisecond)
+		return
+	}
+	shadowMu.Lock()
+	if gen != 0 && gen != shadowGen {
+		shadowMu.Unlock()
+		return
+	}
+	if raw, err := os.ReadFile(shadowSaved); err == nil {
+		shadowSet(strings.TrimSpace(string(raw)))
+		os.Remove(shadowSaved)
+		voiceLog("ShadowMaster restored to %s", strings.TrimSpace(string(raw)))
+	}
+	shadowMu.Unlock()
+	announceGateOpen()
+}
+
+// The legacy announcement waits behind this gate while a refusal may still be
+// dropped: cleanup_directive_controller also cancels a request in flight, so
+// an announcement sent too early would be lost.
+var (
+	gateMu sync.Mutex
+	gateCh chan struct{}
