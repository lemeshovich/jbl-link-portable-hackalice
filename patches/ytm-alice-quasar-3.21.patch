+// voiceLog appends one line to /tmp/ytm-voice.log, a journal of Alice states
+// and of what this daemon did about them, kept small for the flash-backed tmp.
+func voiceLog(format string, args ...any) {
+	voiceLogMu.Lock()
+	defer voiceLogMu.Unlock()
+	const path = "/tmp/ytm-voice.log"
+	if st, err := os.Stat(path); err == nil && st.Size() > 256<<10 {
+		os.Remove(path)
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	fmt.Fprintf(f, "%s "+format+"\n", append([]any{time.Now().Format("15:04:05.000")}, args...)...)
